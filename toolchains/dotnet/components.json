{
  "schema_version": 1,
  "project": "Gordus-Hub/Gordus-Hub",
  "toolchain": "dotnet",
  "state": "DOTNET_TOOLCHAIN_CANDIDATE_NOT_RUNTIME_CERTIFIED",
  "policy": {
    "isolation": "separate-image-and-workflow",
    "isolated_from": [
      "ai/",
      "scripts/ai/",
      "toolchains/java/",
      "toolchains/mojo/",
      "toolchains/go/",
      "toolchains/cpp/",
      "toolchains/rust/",
      "toolchains/node/",
      "toolchains/swift/",
      ".devcontainer/",
      "kestra/flows/"
    ],
    "fail_closed": true,
    "checksum_required": true,
    "checksum_algorithm": "sha512",
    "checksum_source": "official releases.json",
    "mutable_versions_allowed": false,
    "lock_files_required": true,
    "restore_locked_mode": true,
    "external_packages_allowed": false,
    "package_downloads_by_default": false,
    "telemetry": "off (DOTNET_CLI_TELEMETRY_OPTOUT=1)",
    "system_python_allowed": false,
    "network_tools_allowed": false,
    "persistent_installation_authorized": false,
    "certification": "NOT_GRANTED"
  },
  "dockerfile": "toolchains/dotnet/Dockerfile",
  "base_image": "debian:13-slim",
  "components": [
    {
      "id": "dotnet-sdk",
      "kind": "sdk",
      "vendor": "Microsoft / .NET Foundation",
      "distribution": "builds.dotnet.microsoft.com official binary tarball",
      "version": "10.0.402",
      "runtime_version": "10.0.13",
      "csharp_version": "14.0",
      "channel": "10.0",
      "support_phase": "active",
      "release_type": "lts",
      "release_date": "2026-10-13",
      "source": "https://builds.dotnet.microsoft.com/dotnet/Sdk/10.0.402/",
      "checksum_source": "https://builds.dotnet.microsoft.com/dotnet/release-metadata/10.0/releases.json",
      "install_path": "/usr/share/dotnet",
      "artifacts": [
        {
          "arch": "amd64",
          "rid": "linux-x64",
          "file": "dotnet-sdk-10.0.402-linux-x64.tar.gz",
          "url": "https://builds.dotnet.microsoft.com/dotnet/Sdk/10.0.402/dotnet-sdk-10.0.402-linux-x64.tar.gz",
          "sha512": "1904a98dda2db34ba78ba3c4fb1b224455329af91c341d83547843c1839e112b04ae699ee92fa2449a8f62249196a938723078c0c60b9f65c88539d5687729c2"
        },
        {
          "arch": "arm64",
          "rid": "linux-arm64",
          "file": "dotnet-sdk-10.0.402-linux-arm64.tar.gz",
          "url": "https://builds.dotnet.microsoft.com/dotnet/Sdk/10.0.402/dotnet-sdk-10.0.402-linux-arm64.tar.gz",
          "sha512": "db85ae85527251fbb1290720ac3bf324bb1d9eea74516ef291ed4bb1f8ff6ec63a17593367f49b456115e8b24ead6d0c2ece2801e501f36a6cd4444ed01a498f"
        }
      ],
      "license": {
        "value": "MIT",
        "file": "/usr/share/dotnet/LICENSE.txt",
        "status": "DECLARED"
      },
      "environment": {
        "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
        "DOTNET_NOLOGO": "1",
        "DOTNET_SKIP_FIRST_TIME_EXPERIENCE": "1",
        "DOTNET_GENERATE_ASPNET_CERTIFICATE": "false",
        "DOTNET_CLI_WORKLOAD_UPDATE_NOTIFY_DISABLE": "1",
        "DOTNET_ADD_GLOBAL_TOOLS_TO_PATH": "0",
        "DOTNET_CLI_HOME": "/var/lib/gordus-dotnet/cli-home",
        "NUGET_PACKAGES": "/var/lib/gordus-dotnet/nuget/packages",
        "NUGET_HTTP_CACHE_PATH": "/var/lib/gordus-dotnet/nuget/http-cache"
      },
      "tools": [
        "dotnet (CLI)",
        "csc / Roslyn C# 14 compiler",
        "NuGet client (dotnet restore, no remote sources)",
        "MSBuild"
      ]
    }
  ],
  "native_dependencies": {
    "ca-certificates": "20250419+deb13u1",
    "libicu76": "76.1-4",
    "libssl3t64": "3.5.7-1~deb13u3",
    "tzdata": "2026e-0+deb13u1"
  },
  "example": {
    "path": "toolchains/dotnet/examples/hola",
    "projects": ["Hola/Hola.csproj", "Hola.Tests/Hola.Tests.csproj"],
    "lock_files": ["Hola/packages.lock.json", "Hola.Tests/packages.lock.json"],
    "test_strategy": "self-check console project (xUnit/MSTest/NUnit need NuGet.org packages, not allowed offline)"
  },
  "smoke_test": "toolchains/dotnet/tests/test_dotnet_toolchain.sh",
  "scope": ".NET 10 SDK (dotnet CLI + C# compiler + NuGet client) for the example project; no external packages, no network by default"
}
