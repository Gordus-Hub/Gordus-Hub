{
  "schema_version": 1,
  "project": "Gordus-Hub/Gordus-Hub",
  "state": "THREE_LIBRARY_INSTALL_AUTHORIZED_NOT_ACTIVATED",
  "policy": {
    "installation_mode": "isolated-venvs",
    "fail_closed": true,
    "evidence_required": true,
    "mutable_package_versions_allowed": false,
    "persistent_installation_authorized": true,
    "model_weight_downloads_in_ci": false,
    "model_execution_authorized": false,
    "argos_language_package_downloads_in_ci": false,
    "cltk_language_resource_downloads_in_ci": false,
    "inspect_ai_suite_execution_authorized": false
  },
  "components": [
    {
      "id": "argostranslate",
      "kind": "python-package",
      "source": "https://github.com/argosopentech/argos-translate",
      "package": "argostranslate",
      "package_version": "1.11.0",
      "requirements_file": "ai/requirements/argos-translate.txt",
      "license": {
        "value": "MIT OR CC0",
        "status": "LIBRARY_LICENSE_DECLARED_MODEL_PACK_METADATA_REQUIRES_PER_ASSET_REVIEW"
      },
      "installation_enabled": true,
      "smoke_test": "import argostranslate, argostranslate.package, argostranslate.translate",
      "scope": "offline translation library; only individually approved direct-pair .argosmodel assets may be added later"
    },
    {
      "id": "cltk",
      "kind": "python-package",
      "source": "https://github.com/cltk/cltk",
      "package": "cltk",
      "package_version": "2.5.1",
      "requirements_file": "ai/requirements/cltk.txt",
      "license": {
        "value": "MIT",
        "status": "DECLARED"
      },
      "installation_enabled": true,
      "smoke_test": "from cltk import NLP",
      "scope": "classical-language NLP; local resource profiles must be approved and present before analysis; no automatic resource download"
    },
    {
      "id": "inspect-ai",
      "kind": "python-package",
      "source": "https://github.com/UKGovernmentBEIS/inspect_ai",
      "package": "inspect-ai",
      "package_version": "0.3.280",
      "requirements_file": "ai/requirements/inspect-ai.txt",
      "license": {
        "value": "MIT",
        "status": "DECLARED"
      },
      "installation_enabled": true,
      "smoke_test": "import inspect_ai",
      "scope": "evaluation framework only; suite definitions require explicit review and results do not constitute certification"
    }
  ]
}
